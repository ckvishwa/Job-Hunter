<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="description" content="Orbital helps you review your experience, explore cybersecurity career paths, and discover what's possible." />
  <title>Orbital — Discover where your skills belong</title>
  <style is:global>
    :root { --ink:#101116; --royal:#2855E8; --paper:#fff; --blue-wash:#eaf1ff; --hair:#d9dbe0; --muted:#5d6370; --wrap:1440px; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { margin:0; background:var(--paper); color:var(--ink); font-family:Inter, "Helvetica Neue", Arial, sans-serif; -webkit-font-smoothing:antialiased; }
    a { color:inherit; text-decoration:none; }
    button, a { -webkit-tap-highlight-color:transparent; }
    button:focus-visible, a:focus-visible, summary:focus-visible { outline:3px solid var(--royal); outline-offset:4px; }
    svg { display:block; }
    .wrap { max-width:var(--wrap); padding-inline:clamp(22px,4.5vw,68px); margin-inline:auto; }
    .eyebrow { font-size:11px; text-transform:uppercase; font-weight:850; letter-spacing:.29em; line-height:1.5; }
    .section-number { display:inline-flex; min-width:40px; min-height:34px; padding:5px 9px; align-items:center; justify-content:center; color:var(--royal); background:var(--blue-wash); border:1px solid #d7e3ff; font-weight:850; border-radius:10px; font-size:12px; }
    .muted { color:var(--muted); }
    .display { font-size:clamp(53px,6.6vw,108px); font-weight:950; line-height:.9; letter-spacing:-.075em; margin:18px 0 26px; }
    .display .blue { color:var(--royal); }
    .section-title { font-size:clamp(43px,4.45vw,70px); line-height:.96; letter-spacing:-.064em; font-weight:930; margin:16px 0; }
    .body-copy { font-size:clamp(16px,1.22vw,20px); line-height:1.55; color:#4b505b; }
    .btn { display:inline-flex; gap:12px; align-items:center; justify-content:center; min-height:52px; padding:12px 19px; border:1px solid var(--ink); border-radius:10px; font-size:14px; font-weight:800; letter-spacing:-.015em; transition:transform .18s ease, box-shadow .18s ease, background .18s ease; }
    .btn:hover { transform:translateY(-2px); box-shadow:0 8px 24px #10111616; }
    .btn--dark { color:white; background:var(--ink); }
    .btn--blue { background:var(--royal); border-color:var(--royal); color:white; }
    .btn--light { background:white; }
    .btn svg { width:18px; height:18px; }
    .site-header { position:sticky; z-index:20; top:0; background:rgba(255,255,255,.94); backdrop-filter:blur(14px); border-bottom:1px solid #eeeeef; }
    .nav { height:83px; display:flex; gap:28px; align-items:center; justify-content:space-between; }
    .brand { display:flex; gap:12px; align-items:center; font-weight:950; font-size:28px; letter-spacing:-.075em; }
    .brand-mark { height:42px; width:42px; flex:none; }
    .nav-links { display:flex; gap:clamp(18px,2.7vw,43px); align-items:center; }
    .nav-links a { font-size:13px; font-weight:700; color:#2d3139; transition:color .18s; }
    .nav-links a:hover { color:var(--royal); }
    .nav-actions { display:flex; gap:9px; align-items:center; }
    .nav-actions .btn { min-height:40px; padding:8px 16px; font-size:12px; }
    .menu-button { display:none; }
    .mobile-links { display:none; }
    .hero { overflow:hidden; }
    .hero-inner { min-height:650px; padding-top:55px; padding-bottom:54px; display:grid; grid-template-columns:.98fr 1.02fr; gap:16px; align-items:center; }
    .hero-copy { position:relative; z-index:2; max-width:660px; }
    .hero-copy .eyebrow { color:#282d39; }
    .hero-copy .body-copy { max-width:555px; margin:0 0 28px; }
    .hero-actions { display:flex; flex-wrap:wrap; gap:12px; }
    .micro-line { display:flex; align-items:center; flex-wrap:wrap; gap:11px; margin-top:28px; color:#515763; font-size:12px; font-weight:650; }
    .micro-line > span { display:inline-flex; align-items:center; gap:7px; }
    .micro-line .dot { width:5px; height:5px; border-radius:2px; background:var(--royal); }
    .hero-visual { position:relative; height:570px; min-width:0; isolation:isolate; }
    .graphic-panel { position:absolute; inset:14px -32px 10px -8px; background:linear-gradient(160deg,#fff 5%,#f3f7ff 54%,#fff 92%); border-radius:36px; }
    .graphic-grid { position:absolute; inset:0; opacity:.4; background-image:linear-gradient(to right,#2855e81b 1px,transparent 1px),linear-gradient(to bottom,#2855e81b 1px,transparent 1px); background-size:48px 48px; mask-image:radial-gradient(ellipse at center,black 15%,transparent 73%); }
    .graphic-art { position:absolute; inset:10px -20px 0 -30px; width:calc(100% + 50px); height:100%; overflow:visible; }
    .orbit-ring { stroke:var(--royal); stroke-width:2.1; opacity:.75; fill:none; }
    .orbit-spin { transform-origin:center; animation:revolve 26s linear infinite; }
    .floating-pill { position:absolute; background:rgba(255,255,255,.97); box-shadow:0 9px 35px #141e4930; border:1px solid #dce3f4; border-radius:16px; display:flex; gap:9px; align-items:center; padding:11px 14px; font-size:12px; font-weight:850; white-space:nowrap; animation:levitate 6s ease-in-out infinite; }
    .floating-pill svg { width:23px; height:23px; }
    .pill-one { top:13%; left:7%; }
    .pill-two { top:28%; right:0; animation-delay:-2s; }
    .pill-three { bottom:18%; left:1%; animation-delay:-3.5s; }
    .visual-note { position:absolute; bottom:54px; right:-7px; display:flex; gap:8px; align-items:center; transform:rotate(-7deg); color:#13151b; font-family:"Courier New",monospace; font-weight:bold; line-height:1.35; letter-spacing:-.045em; font-size:15px; }
    .visual-note svg { width:36px; height:36px; }
    .visual-caption { position:absolute; top:3%; right:12%; font-family:"Courier New",monospace; font-size:11px; font-weight:bold; letter-spacing:.12em; }
    .section-heading-row { display:flex; align-items:center; gap:15px; margin-bottom:19px; }
    .section-heading-row .eyebrow { color:#3f4550; }
    .resume-section { background:#f8f9fc; border-top:1px solid #edeef2; border-bottom:1px solid #eaedf2; }
    .resume-wrap { padding-block:49px 59px; }
    .resume-grid { display:grid; grid-template-columns:1fr 1.1fr .92fr; gap:14px; align-items:stretch; }
    .resume-intro { padding:10px 20px 12px 0; }
    .resume-intro .section-title { max-width:365px; }
    .resume-intro .body-copy { max-width:360px; font-size:16px; }
    .white-card { background:white; border:1px solid var(--hair); border-radius:16px; box-shadow:0 7px 24px #1c234608; }
    .upload-card { padding:20px; display:flex; flex-direction:column; gap:20px; }
    .card-head { display:flex; align-items:center; gap:12px; font-size:13px; font-weight:850; }
    .upload-target { flex:1; border:1.5px dashed #a5afc4; border-radius:13px; background:#fff; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:22px 12px; text-align:center; }
    .upload-target svg { width:43px; height:43px; color:#101116; }
    .upload-target strong { font-size:14px; }
    .upload-target p { margin:0; font-size:12px; line-height:1.45; color:#636b7b; }
    .upload-target .btn { margin-top:8px; min-height:40px; min-width:150px; }
    .verification-card { padding:20px; }
    .verification-graphic { margin:20px auto 13px; width:118px; height:118px; border:12px solid #e5ecfc; border-top-color:var(--royal); border-right-color:var(--royal); border-radius:50%; display:flex; flex-direction:column; align-items:center; justify-content:center; transform:rotate(-26deg); }
    .verification-graphic span { transform:rotate(26deg); font-size:13px; font-weight:950; text-align:center; line-height:1.15; }
    .checklist { padding:0; margin:16px 0 0; list-style:none; display:grid; gap:12px; }
    .checklist li { display:flex; align-items:center; gap:11px; font-size:13px; font-weight:650; }
    .tick { width:24px; height:24px; background:#e8efff; color:var(--royal); font-weight:900; display:grid; place-items:center; border-radius:50%; flex:none; }
    .careers { background:#e9f1ff; }
    .career-wrap { padding-block:62px 68px; }
    .career-grid { display:grid; grid-template-columns:1.25fr repeat(4,1fr); gap:15px; align-items:stretch; }
    .career-intro { padding-right:14px; }
    .career-intro .section-title { max-width:330px; font-size:clamp(39px,3.5vw,54px); }
    .career-intro p { font-size:15px; line-height:1.55; }
    .career-intro .btn { margin-top:14px; }
    .career-card { display:flex; flex-direction:column; gap:0; overflow:hidden; background:white; border:1px solid #d5e0f5; border-radius:16px; box-shadow:0 6px 20px #1b32800b; transition:transform .2s,box-shadow .2s; }
    .career-card:hover { transform:translateY(-5px); box-shadow:0 12px 28px #1b328028; }
    .career-art { min-height:148px; display:grid; place-items:center; position:relative; overflow:hidden; background:radial-gradient(circle at 50% 46%,#ffffff 0 21%,#bcd0ff 22% 51%,#e9f1ff 52% 100%); }
    .career-art:after { content:""; position:absolute; width:110px; height:110px; border:1px solid var(--royal); transform:rotate(27deg); opacity:.3; }
    .career-art svg { height:78px; width:78px; z-index:1; stroke:#141d32; stroke-width:2.3; fill:none; stroke-linecap:round; stroke-linejoin:round; }
    .career-body { flex:1; display:flex; flex-direction:column; padding:17px; }
    .career-card h3 { margin:0 0 7px; font-weight:900; font-size:17px; letter-spacing:-.045em; }
    .career-card p { margin:0 0 13px; color:#4d5360; font-size:12px; line-height:1.55; }
    .tags { display:flex; flex-wrap:wrap; gap:6px; margin:auto 0 19px; }
    .tags span { background:#eaf1ff; color:#264dba; padding:5px 8px; border-radius:6px; font-size:10px; font-weight:800; }
    .card-bottom { display:flex; align-items:center; justify-content:space-between; border-top:1px solid #e7eaf1; padding-top:10px; font-size:11px; font-weight:850; }
    .card-bottom a { display:flex; align-items:center; gap:5px; color:var(--royal); }
    .card-bottom a svg { width:16px; height:16px; }
    .how-wrap { padding-block:63px 71px; }
    .how-grid { display:grid; grid-template-columns:1.23fr repeat(4,.75fr); gap:13px; }
    .how-intro { padding-right:18px; }
    .how-intro .section-title { max-width:390px; }
    .how-intro .body-copy { font-size:15px; max-width:410px; }
    .step-card { border:1px solid var(--hair); border-radius:15px; padding:17px 16px 20px; min-height:225px; background:white; }
    .step-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; }
    .step-top .section-number { width:33px; min-width:33px; height:33px; min-height:33px; }
    .step-top svg { height:32px; width:32px; color:#18254c; }
    .step-card h3 { font-size:15px; letter-spacing:-.035em; font-weight:900; margin:0 0 9px; }
    .step-card p { font-size:12px; line-height:1.5; color:#656a75; margin:0; }
    .coming { font-size:10px; text-transform:uppercase; color:var(--royal); font-weight:950; letter-spacing:.09em; margin-top:13px; }
    .closing { padding-block:0 63px; }
    .closing-inner { display:grid; grid-template-columns:1fr auto; gap:20px; align-items:center; background:#101116; border-radius:22px; padding:35px 40px; color:white; overflow:hidden; position:relative; }
    .closing-inner::after { content:""; position:absolute; width:330px; height:330px; border:1px solid #2855e881; border-radius:50%; right:13%; top:-180px; transform:rotate(20deg) scaleX(1.65); pointer-events:none; }
    .closing .eyebrow { color:#98b2ff; }
    .closing h2 { margin:10px 0; font-size:clamp(28px,3vw,48px); font-weight:950; line-height:1; letter-spacing:-.06em; }
    .closing p { color:#ced3dd; margin:0; max-width:660px; line-height:1.6; }
    .closing .btn { position:relative; z-index:1; }
    .footer { padding:23px 0 29px; border-top:1px solid #e9e9ee; }
    .footer-inner { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:18px; }
    .footer .brand { font-size:22px; }
    .footer .brand-mark { height:30px; width:30px; }
    .footer small { color:#626879; font-size:11px; }
    .footer .footer-links { display:flex; gap:20px; font-size:12px; font-weight:750; }
    @keyframes levitate { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-9px); } }
    @keyframes revolve { from {transform:rotate(0deg);} to {transform:rotate(360deg);} }
    @media(max-width:1200px) { .nav-links{gap:17px}.hero-inner{grid-template-columns:1fr 1fr}.hero-visual{height:500px}.graphic-art{inset:10px -10px 0 -20px}.career-grid{grid-template-columns:repeat(4,1fr)}.career-intro{grid-column:1/-1;max-width:600px;margin-bottom:5px}.career-intro .section-title{max-width:none}.how-grid{grid-template-columns:repeat(4,1fr)}.how-intro{grid-column:1/-1;max-width:620px}.resume-grid{grid-template-columns:1fr 1fr}.resume-intro{grid-column:1/-1}.resume-intro .section-title{max-width:760px}.resume-intro .body-copy{max-width:660px} }
    @media(max-width:820px) { .nav-links,.nav-actions{display:none}.menu-button{display:block;background:white;border:1px solid #e5e6ed;padding:10px 12px;border-radius:10px;font-weight:900}.mobile-links{display:none;position:absolute;top:83px;left:0;right:0;flex-direction:column;padding:18px 24px;background:white;border-bottom:1px solid #e7e8eb;box-shadow:0 16px 30px #20203011}.mobile-links.open{display:flex}.mobile-links a{padding:13px 5px;font-size:14px;font-weight:800}.hero-inner{padding-top:44px;grid-template-columns:1fr;gap:0}.hero-visual{height:480px;max-width:660px;width:100%;margin-inline:auto}.hero-copy{max-width:700px}.display{font-size:clamp(60px,10vw,88px)}.how-grid{grid-template-columns:repeat(2,1fr)}.career-grid{grid-template-columns:repeat(2,1fr)}.career-intro{grid-column:1/-1}.closing-inner{grid-template-columns:1fr} }
    @media(max-width:560px) { .wrap{padding-inline:19px}.nav{height:72px}.brand{font-size:24px}.brand-mark{height:36px;width:36px}.mobile-links{top:72px}.hero-inner{padding-top:37px;padding-bottom:26px}.display{font-size:clamp(51px,12.8vw,69px);letter-spacing:-.08em}.eyebrow{font-size:9px}.hero-copy .body-copy{font-size:15px}.hero-visual{height:365px}.graphic-art{inset:10px -5px 0 -12px;width:calc(100% + 25px)}.floating-pill{font-size:10px;padding:8px 9px;border-radius:11px}.floating-pill svg{width:16px;height:16px}.pill-one{top:8%}.pill-two{right:-2%;top:30%}.pill-three{left:0;bottom:18%}.visual-note{font-size:11px;bottom:22px;right:0}.visual-caption{font-size:9px}.micro-line{font-size:11px}.resume-grid{grid-template-columns:1fr}.resume-intro{grid-column:auto;padding:0}.upload-card{min-height:320px}.verification-card{min-height:345px}.career-grid{grid-template-columns:1fr 1fr;gap:10px}.career-intro{grid-column:1/-1}.career-art{min-height:110px}.career-art svg{width:57px;height:57px}.career-body{padding:12px}.career-card h3{font-size:15px}.tags{margin-bottom:12px}.how-grid{grid-template-columns:1fr 1fr;gap:10px}.step-card{min-height:225px}.closing-inner{padding:29px 24px}.footer-inner{align-items:flex-start;flex-direction:column}.section-title{font-size:46px} }
    @media(prefers-reduced-motion:reduce) { html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important} }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="nav wrap">
      <a href="#top" class="brand" aria-label="Orbital home">
        <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true"><rect x="3" y="3" width="42" height="42" rx="9" fill="#101116"/><path d="M11 32 32 11h9L20 36h-9Z" fill="#fff"/><path d="M7 39 32 13h9L16 39Z" fill="#2855e8"/><path d="M37 4h7v7H29Z" fill="#2855e8"/></svg>
        <span>orbital<span style="color:var(--royal)">.</span></span>
      </a>
      <nav class="nav-links" aria-label="Main navigation">
        <a href="#top">Home</a><a href="#how">How it works</a><a href="#paths">Career paths</a><a href="/roles">My roles</a>
