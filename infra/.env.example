# Copy to infra/.env (gitignored) and replace every CHANGE_ME. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JH_PG_USER=jobhunter
JH_PG_PASSWORD=CHANGE_ME
JH_PG_DB=jobhunter
JH_PG_PORT=55440

# Local API (TypeScript). The access token is what the single local user types into the UI to start a session.
JH_API_HOST=127.0.0.1
JH_API_PORT=8787
JH_API_ACCESS_TOKEN=CHANGE_ME
JH_SESSION_SECRET=CHANGE_ME

# Internal Python AI service. Only the TypeScript API may call it.
JH_AI_HOST=127.0.0.1
JH_AI_PORT=8765
JH_AI_SERVICE_TOKEN=CHANGE_ME
# Optional Qwen fallback inside the AI service; off unless set to 1.
JH_AI_QWEN_FALLBACK=0

# Optional: run a second, separate database stack (e.g. an integration checkout) without touching the first.
# JH_COMPOSE_PROJECT=jobhunter-s1
# JH_PG_CONTAINER=jobhunter-s1-pg
# JH_PG_VOLUME=jobhunter_s1_pgdata
