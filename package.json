{
  "name": "job-hunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright-based job search automation: scrapes configured career sites, matches JDs against resume profiles, produces ranked reports.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "tsx src/testing/cli.ts changed",
    "test:failed": "tsx src/testing/cli.ts failed",
    "test:resume": "tsx src/testing/cli.ts resume",
    "test:status": "tsx src/testing/cli.ts status",
    "test:full": "tsx src/testing/cli.ts full",
    "collect": "tsx src/runner/cli.ts",
    "discover": "tsx src/discovery/cli.ts",
    "parse-jd": "tsx src/semantic/cli.ts",
    "pipeline": "tsx src/pipeline/cli.ts",
    "nlu:smoke": "tsx src/nlu/smoke.ts",
    "pipeline:offline": "vitest run tests/pipeline/offline-e2e.test.ts",
    "decide": "tsx src/decision/cli.ts",
    "tracker": "tsx src/tracker/cli.ts",
    "dashboard": "tsx src/dashboard/cli.ts",
    "boards:discover": "tsx src/pipeline/discovery/boards-cli.ts",
    "boards:import": "tsx src/pipeline/discovery/board-list-import.ts",
    "boards:verify": "tsx src/pipeline/discovery/board-verify.ts",
    "candidate:import": "tsx src/candidate/cli.ts",
    "candidate:review": "tsx src/candidate/review-cli.ts",
    "search": "tsx src/discovery/search-cli.ts",
    "hunt": "tsx src/hunt/cli.ts",
    "audit:fortune500": "tsx src/config/fortune500-audit-cli.ts",
    "packet": "tsx src/packet/cli.ts",
    "ci:audit": "tsx src/ci/audit-gate.ts",
    "ci:isolation": "tsx src/ci/private-isolation.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "roles:seed": "tsx src/db/roles-seed-cli.ts",
    "api": "tsx src/api/cli.ts",
    "s3:pilot": "tsx src/jobs/pilot-cli.ts",
    "dev:stack": "pwsh -NoProfile -File scripts/dev-stack.ps1 start",
    "dev:stack:status": "pwsh -NoProfile -File scripts/dev-stack.ps1 status",
    "dev:stack:stop": "pwsh -NoProfile -File scripts/dev-stack.ps1 stop",
    "facts:list": "tsx src/candidate/fact-cli.ts list",
    "facts:export": "tsx src/candidate/fact-cli.ts export",
    "facts:review": "tsx src/candidate/fact-cli.ts review",
    "facts:apply": "tsx src/candidate/fact-cli.ts apply",
    "facts:correct": "tsx src/candidate/fact-cli.ts correct",
    "resumes:diagnose": "tsx src/candidate/diagnose-cli.ts",
    "profile": "tsx src/candidate/profile-cli.ts",
    "browser:login": "tsx src/browser/cli.ts login",
    "browser:status": "tsx src/browser/cli.ts status",
    "match": "tsx src/match/match-cli.ts",
    "match:store": "tsx src/match/store-cli.ts",
    "jobs:import": "tsx src/jobs/import-cli.ts",
    "match:gold": "tsx src/match/gold-cli.ts",
    "match:jd-compare": "tsx src/match/jd-compare-cli.ts",
    "ai:eval": "pwsh -NoProfile -File scripts/ai-eval.ps1",
    "m5:audit": "tsx scripts/m5-export.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@huggingface/transformers": "^4.3.1",
    "fastify": "^5.12.5",
    "js-yaml": "^4.3.2",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "playwright": "^1.47.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
