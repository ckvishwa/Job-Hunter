{
  "name": "job-hunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Playwright-based job search automation: scrapes configured career sites, matches JDs against resume profiles, produces ranked reports.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "collect": "tsx src/runner/cli.ts",
    "discover": "tsx src/discovery/cli.ts",
    "hunt": "tsx src/hunt/cli.ts",
    "audit:fortune500": "tsx src/config/fortune500-audit-cli.ts"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "playwright": "^1.47.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
