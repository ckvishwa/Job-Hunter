---
// Orbital logomark: square, angled ink / white / royal-blue tile with a corner notch. Not a circle, not a character.
interface Props { class?: string; size?: number }
const { class: cls = "brand-mark", size } = Astro.props;
---
<svg class={cls} viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" focusable="false"><rect x="3" y="3" width="42" height="42" rx="9" fill="#101116"/><path d="M11 32 32 11h9L20 36h-9Z" fill="#fff"/><path d="M7 39 32 13h9L16 39Z" fill="#2855e8"/><path d="M37 4h7v7H29Z" fill="#2855e8"/></svg>
